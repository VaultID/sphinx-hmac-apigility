{
    "name": "vaultid/sphinx-hmac-apigility",
    "description": "Hash-based Message Authentication Code (HMAC) for ZendFramework2",
    "license": "Apache-2.0",
    "keywords": [
        "hmac",
        "zf3",
        "apigility"
    ],
    "homepage": "https://github.com/vaultid/sphinx-hmac-apigility",
    "autoload": {
        "psr-4": {
            "RB\\Sphinx\\Hmac\\Zend\\": "./src/"
        },
        "classmap": [
            "./Module.php"
        ]
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/reinaldoborges/rb-sphinx-hmac.git"
        }
    ],
    "require": {
        "php": "^8.0",
        "rb/sphinx-hmac": "v1.0.0",
        "laminas/laminas-http": "~2.18",
        "laminas/laminas-dependency-plugin": "^2.2"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-develop": "0.1-dev"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ZendTest\\Http\\": "test/"
        },
        "classmap": [
            "./Module.php"
        ]
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "config": {
        "allow-plugins": {
            "laminas/laminas-dependency-plugin": true
        }
    }
}
